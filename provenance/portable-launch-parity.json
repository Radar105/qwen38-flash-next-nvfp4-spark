{
  "pass": true,
  "scope": "Executed portable serve.sh against a capture executable; semantic engine flags match managed runtime. No second engine started.",
  "flags": {
    "--served-model-name": "nvidia/Qwen3.8-Flash-Next-NVFP4",
    "--tensor-parallel-size": "1",
    "--dtype": "bfloat16",
    "--quantization": "modelopt",
    "--max-model-len": "262144",
    "--max-num-seqs": "1",
