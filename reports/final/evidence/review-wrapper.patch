+def gpu_memory_mb() -> dict[int, dict[str, int]]:
+    """GB10 shares host RAM: use reclaimable availability, not bare MemFree."""
+    if not _uses_gb10_uma():
+        return _gpu_memory_mb()
+    try:
+        fields = {}
+        for line in Path("/proc/meminfo").read_text().splitlines():
+            key, value = line.split(":", 1)
