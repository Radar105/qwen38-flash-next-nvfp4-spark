+def qwen4_mapped_ple_mb(target: Path, profile: Profile) -> int:
+    """Exclude only verified file-backed FP8 PLE tables from resident weights.
+
+    Keep the normal runtime reserve for page cache and lookup staging. Invalid
+    or incomplete metadata retains the conservative full-checkpoint estimate.
+    """
+    if profile.extra_env.get("VLLM_QWEN4_PLE_MMAP") != "1":
+        return 0
+    try:
+        root = target.resolve()
+        config = json.loads((root / "config.json").read_text())
+        parts = int(config["text_config"]["split_ngram_parts"])
+        index = json.loads((root / "model.safetensors.index.json").read_text())
+        pattern = re.compile(
+            r"model\.language_model\.layers\.\d+\.ple\.ple_embedding\."
+            r"ngram_embedding\.shard_(\d+)\.weight$"
+        )
+        entries = [(name, file) for name, file in index["weight_map"].items()
+                   if pattern.fullmatch(name)]
+        if len(entries) != parts or {
+            int(pattern.fullmatch(name).group(1)) for name, _ in entries
+        } != set(range(parts)):
+            return 0
+        headers = {}
+        mapped_bytes = 0
+        for name, filename in entries:
+            path = (root / filename).resolve()
+            if not path.is_relative_to(root):
+                return 0
+            if path not in headers:
+                with path.open("rb") as handle:
+                    length = struct.unpack("<Q", handle.read(8))[0]
+                    if length > 100_000_000:
+                        return 0
+                    headers[path] = (8 + length, json.loads(handle.read(length)))
+            offset, header = headers[path]
+            item = header[name]
+            lo, hi = item["data_offsets"]
+            shape = item["shape"]
+            if (item["dtype"] != "F8_E4M3" or len(shape) != 2
+                    or lo < 0 or hi - lo != shape[0] * shape[1]
+                    or offset + hi > path.stat().st_size):
+                return 0
+            mapped_bytes += hi - lo
+        return mapped_bytes // (1024 * 1024)
+    except (OSError, ValueError, KeyError, TypeError, struct.error):
+        return 0
+
